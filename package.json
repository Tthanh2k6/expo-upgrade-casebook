    "resolver": "<rootDir>/jest.resolver.js",
    "modulePathIgnorePatterns": [
      "<rootDir>/.expo/"
    ],
    "snapshotSerializers": [
      "<rootDir>/jest.reactElementSerializer.js"
    ]
  },
  "engines": {
    "node": ">=20.19.4"
